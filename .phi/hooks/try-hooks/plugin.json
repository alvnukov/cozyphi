{
  "name": "try-hooks",
  "hooks": [
    {
      "name": "guard-bash",
      "event": "pre_tool",
      "match": "bash",
      "run": "./guard.py",
      "timeout": "5s",
      "fail_closed": true
    },
    {
      "name": "stamp-tools",
      "event": "post_tool",
      "match": "*",
      "run": "./stamp.py",
      "timeout": "5s"
    }
  ]
}
